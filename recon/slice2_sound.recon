		case ProtoInfoTypes.CharacterSound:
			return new CSProtoInfoManager_CharacterSound();
		case ProtoInfoTypes.CharAnim:
			return new CSProtoInfoManager_CharAnim();
		case ProtoInfoTypes.ShowBox:
