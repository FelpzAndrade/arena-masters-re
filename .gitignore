# Lista do que entra no git: ignora tudo e libera so codigo, scripts, anotacoes e configuracoes.
# (pastas grandes ficam de fora: APK extraido, dumps, Ghidra, Library do Unity, copia de teste, assets da Asset Store)
/*
!/.gitignore
!/CLAUDE.md

!/tools/
/tools/*
!/tools/*.py
!/tools/*.sh
!/tools/*.ps1
!/tools/ghidra_scripts/
!/tools/blender/
/tools/blender/*
!/tools/blender/abrir_axie.py
!/tools/blender/axie.blend

!/decomp/
/decomp/*
!/decomp/*.md

!/recon/
!/wiki/

!/unity6-project/
/unity6-project/*
!/unity6-project/ProjectSettings/
!/unity6-project/Packages/
!/unity6-project/Assets/
